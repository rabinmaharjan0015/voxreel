# No provider API keys here on purpose. Users bring their own keys from the UI.
ALLOWED_ORIGINS=http://localhost:3000
WHISPER_MODEL=small
OUTPUT_DIR=./outputs
DATA_DIR=./data
REDIS_URL=redis://localhost:6379/0
# Encrypts user keys while they wait in Redis (deleted when the job starts).
# Set a long random string in production; if empty a random key file is created in DATA_DIR.
KEY_ENCRYPTION_SECRET=
RATE_LIMIT_PER_HOUR=10

# Publishing (your own developer apps; leave blank to disable that platform)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Public HTTPS base for videos when using a posting service (Ayrshare pulls the file from here)
PUBLIC_MEDIA_BASE=

# --- Auth & email ---
# JWT secret for session tokens (falls back to KEY_ENCRYPTION_SECRET if empty)
JWT_SECRET=
# Email provider: "console" (prints to stdout), "smtp", or "resend"
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoxReel <noreply@voxreel.app>
RESEND_API_KEY=

# Default local LLM model (Hugging Face transformers, free tier)
HF_MODEL=Qwen/Qwen2.5-3B-Instruct
